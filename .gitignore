# Rust
/target/
**/*.rs.bk
# Cargo.lock is committed: falcon ships binaries (falcon/falcon-lsp/falcon-mcp),
# so a locked, reproducible dependency graph is required for CI `--locked` builds
# and `cargo install` from a release tag.

# Dart
.dart_tool/
.packages
build/
pubspec.lock

# IDE
.idea/
.vscode/
*.iml
.cursor/
.claude/

# OS
.DS_Store
Thumbs.db

# Self-hosted runner: local machine settings and runner credentials.
# The runner's .credentials/.credentials_rsaparams are OAuth + RSA private key
# material generated by config.sh. They live in the runner install directory,
# never in this repo.
.env
.credentials
.credentials_rsaparams
.runner
