# Self-hosted GitHub Actions runner — local settings.
# Copy to .env and adjust. .env is gitignored; nothing here is secret.
#
# The runner's actual credentials (.credentials, .credentials_rsaparams) are
# generated by config.sh inside RUNNER_ROOT and must never be copied here or
# committed — they authenticate as this runner.

# Where the runner was installed (see scripts/runner/README.md)
RUNNER_ROOT=$HOME/actions-runner-falcon

# launchd label, shown by: launchctl list | grep actions.runner
SVC_LABEL=actions.runner.<owner>-<repo>.<runner-name>
